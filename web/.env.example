# Orako dashboard environment.
# Copy this file to web/.env (gitignored) and fill in real values.

# Auth mode the dashboard runs in (the server has no discovery endpoint, so this
# is set at build time):
#   oidc → Supabase email/password login; the session access_token is the Bearer.
#   dev  → dev-stub token entry (memberID:projectID:role) in localStorage.
# Default is dev so local development without Supabase keeps working.
VITE_ORAKO_AUTH_MODE=dev

# Supabase project — required when VITE_ORAKO_AUTH_MODE=oidc.
# Placeholders only; put the real values in web/.env (never commit them).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
